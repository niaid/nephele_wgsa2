if config["find_args"]:
    rule run_RGI: ## this could be made to somehow use tmp_dir, but pain
        input:
            rules.gene_prediction.output.faa,
        threads: threads_per_job    
        params:
            outDIR  = RGI_DIR,  
            ftype   ='protein',
            inFAA   ="_tmpPREDgenes.faa",
            inFAAm  ="_tmpPREDgenes_noStar.faa",   ## removed "*" or begnign fake "ERROR" message can confuse
            prefix  ="_tmpRGIraw", 
            hmphdrs ="_tmpHeaders.txt",
            carddb  =config["args_db_path"],
            colsAA  ="1,9,11,15,16,17,28",
            sedhdr  ='s/ # .*;gc_cont=0....//g',
            rgi_raw ="RGI_raw.txt", ## used in rule
            rgi_main="{sample}_RGI_main.txt",## used in rule
            rgi_faas="{sample}_RGI_seqs.faa",## used in rule
            rgi_log ="RGIrun_LOG.txt"
        conda: 
            "rgi"
        output: ## output vars not used in rule but produced thorugh corresponding paramsVars
            rgi_raw =RGI_DIR + "RGI_raw.txt", 
            rgi_main=RGI_DIR + "{sample}_RGI_main.txt",
            rgi_faas=RGI_DIR + "{sample}_RGI_seqs.faa",
        shell:"""
            mkdir -p {params.outDIR}

            cp {input} {params.outDIR}/{params.inFAA}
            sed -E  's/\\*//g' {params.outDIR}/{params.inFAA} > {params.outDIR}/{params.inFAAm}  


            echo "---- Starting RGI run for {wildcards.sample} ----"
            cp -r {params.carddb} {params.outDIR}/cardDB/
            cd {params.outDIR}  && rgi load --local -i cardDB/card.json
            rgi main --input_type {params.ftype} -i {params.inFAAm} --clean --local \
                     -o {params.prefix} --data wgs --num_threads {threads} > {params.rgi_log} 2>&1
            

            cut -f '{params.colsAA}' {params.prefix}.txt |sed -E '{params.sedhdr}' >  {params.rgi_main} 
            cut -f1  {params.prefix}.txt > {params.hmphdrs}
            seqtk subseq {params.inFAA} {params.hmphdrs} > {params.rgi_faas}
            cp {params.prefix}.txt  {params.rgi_raw} 
            
            if [[ ! -s {params.rgi_faas} ]]; then
                echo "---- FAIL: RGI found no AMR genes in sample {wildcards.sample}"
            fi

            rm -rf _tmp* localDB cardDB
            """

    rule merge_ARGtabs:
        threads: threads_per_job
        input:
            args=expand(rules.run_RGI.output.rgi_main, sample=samples),
            require=expand(rules.tpm_normalization.output.ABUNtab, sample=samples), #requires completion
        params:
            argMRGscript=config["argSCR_rgi"],
            asmb_all=lambda wildcards: ASMB_MTX if config["denovo_mtx"] else ASMB_MGX 
        output:
            out=PWY_MERGED_TABLES + "merged_argsTPMtable.txt"
        shell:
            "python3 {params.argMRGscript} {params.asmb_all}"

