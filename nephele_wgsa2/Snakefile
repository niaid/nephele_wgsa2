rule all:
    input:
        pipeline_output,


onstart:
    shell(
    """
    set +o pipefail
    echo "Dependencies:"
    conda list fastp -n fastp | tail -n1 | awk '{{print $1,$2}}'
    metaspades.py --version
    bowtie2 --version | awk '{{print "bowtie2 version", $3}}' | head -n1
    samtools --version | head -n1
    metabat2 2>&1 >/dev/null | grep version
    prodigal -v 2>&1 >/dev/null | head -n2 | tail -n1
    conda list checkm -n checkm | tail -n1 | awk '{{print $1,$2}}'
    ktImportText | head -n2 | tail -n1 | sed 's/[^a-zA-Z0-9. ]//g' | sed 's/^ *//g'
    metaprokka --version
    cat {config[minpath_script]} | grep version | head -n1
    verse -v | head -n2 | tail -n1
    kraken2 --version | head -n1
    conda list rgi -n rgi | tail -n1 | awk '{{print $1, $2}}'
    # rgi -h |grep "Resistance Gene Identifier - " | sed 's/ - / version /g'
    emapper.py --version | tail -n1 | awk '{{print $1}}'
    R --version | head -n1
    conda list ribodetector -n ribodetector | tail -n1 | awk '{{print $1,$2}}'
    Trinity --version | head -n1
    snakemake --version | awk '{{print "Snakemake version", $1}}'
    """)



#### ------------ starting main pipeline -----------------


# Step 2 starts
rule run_fastp:
    threads: threads_per_job
    input:
        unpack(get_fastq_gz)
    params:
        f=TMP_DIR + "{sample}_R1_te.fastq.gz",
        r=TMP_DIR + "{sample}_R2_te.fastq.gz",
        tmpdir=TMP_DIR,
        json=TMP_DIR   + "{sample}_fastp.json",
    output:
        text=TED_READS + "{sample}_fastplog.txt",
        html=TED_READS + "{sample}_fastplog.html",
    conda:
        "fastp"
    run:
        shell("mkdir -p {params.tmpdir} && " + run_fastp_cmd())
    # other ways:
    # shell("mkdir -p {params.tmpdir} && " + run_fastp_cmd())
    # shell:"""
    #     mkdir -p {params.tmpdir} && {params.cmd}
    # or "mkdir -p {params.tmpdir} &&" + run_fastp_cmd() 


rule run_kraken2_decontaminate:
    resources:
        mem_gb=config["total_mem_gb"]
    input:
        h=ancient(rules.run_fastp.output.text),
    threads: threads_per_job
    params:
        f=rules.run_fastp.params.f,
        r=rules.run_fastp.params.r,
        decontaminate=config["decontaminate"],
        kr2confd_host=config["kr2confidence_host"],
        out=TMP_DIR + "{sample}_R#_ted.fastq",
        fte=TMP_DIR + "{sample}_R_1_ted.fastq",
        rte=TMP_DIR + "{sample}_R_2_ted.fastq",
        tedtar=config["output_dir"] + "/TEDfastq.tar",
        outdir=config["output_dir"],
        fqsdir=TED_READS_FQS_NAME
    output:
        report=TED_READS     + "{sample}_kr2_contamREPORT.txt",
        outlog=TED_READS     + "{sample}_kr2_contamLOG.txt",
        fwdted=TED_READS_FQS + "{sample}_R1_ted.fastq.gz",
        revted=TED_READS_FQS + "{sample}_R2_ted.fastq.gz",
    shell:"""
        ### touch {input.h}

        if [[ ! -s {output.revted} ]] && [[ -s {params.tedtar} ]] ; then 
            tar -xvf {params.tedtar} -C {params.outdir}/  &&
            touch {output.fwdted} {output.revted}
        else 
            kraken2 --use-names --gzip-compressed --threads {threads} \
            --confidence {params.kr2confd_host} --db {params.decontaminate} \
            --paired {params.f} {params.r} --unclassified-out {params.out} \
            --output -  --report {output.report} 2>> {output.outlog}
            
            pigz -c {params.fte} -p {threads} > {output.fwdted} && \
            pigz -c {params.rte} -p {threads} > {output.revted} 
        fi
        """


# Step 3 starts
rule run_kraken2_classification:
    resources:
        mem_gb=config["total_mem_gb"]
    input:
        f=lambda wildcards: ancient(rules.remove_rRNA.output.fread_gz) if config["denovo_mtx"] else 
                            ancient(rules.run_kraken2_decontaminate.output.fwdted),
        r=lambda wildcards: ancient(rules.remove_rRNA.output.rread_gz) if config["denovo_mtx"] else 
                            ancient(rules.run_kraken2_decontaminate.output.revted),
    threads: threads_per_job
    params:
        classification_db=config["classification_db"],
        kr2confd_taxon=config["kr2confidence_taxonomic"],
    output:
        report=TED_READS_TAX + "reports/{sample}_taxREPORT.txt",
        outlog=TED_READS_TAX + "taxlogs/{sample}_classLOG.txt",
    shell:
        "kraken2 --use-names --gzip-compressed --threads {threads} "
        "--confidence {params.kr2confd_taxon} --db {params.classification_db} --memory-mapping "
        "--paired {input.f} {input.r}  --output - --report {output.report} 2>> {output.outlog}"

rule tax_kreport2krona_per_sample:
    input:
        krfile=ancient(rules.run_kraken2_classification.output.report)
    params:
        kreport2krona_script=config["kreport2krona_script"],
        sedRNK='s_\\tR[12]\\t(.*)(Viruses|Bacteria|Eukaryota|Archaea)_\\tD\\t\\1\\2_g',
        sedSTR='s/\\tUnclassified\\t\\t\\t\\t\\t\\t\\t0/\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\t0/g' # more explicit
    output:
        tmpfile=temp(TED_READS_TAX + "reports/_tmp_{sample}.txt"),
        binfile=TED_READS_TAX + "taxbin/{sample}_wTAXid_4krona.txt"
    shell:
        "sed -E '{params.sedRNK}' {input.krfile} > {output.tmpfile} &&"
        "python3 {params.kreport2krona_script} --report-file {output.tmpfile} --no-tax-prefixes -o {output.binfile} &&"
        "sed -i '{params.sedSTR}'  {output.binfile}"
 ##--> the first SED "fixes" the domain taxonomic rankings in the taxREPORT from the new R1/R2 root designation to the old D designation (consistent)
 ##--> kreport2krona_script is edited to disable table merging, since it overprints the bin/files (required output)
 ##--> removed the mod_kreport2krona_output rule cuz mods are above and no output 
 ##--> last SED old: 's/\\tUnclassified\\t\\t\\t\\t\\t\\t\\t0/\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\t0/g'
 ##--> last SED loop: ':a; 2s/\\t\\t/\\tUnclassified\\t/; ta', ## loops over empty TSV fields on line 2 (expected Unclassified taxid 0), 
 ##--> --> but if line 2 is bacteria\t\t\... it also captures that and acauses error. Leaving to more explicit version
 ##--> last SED "fixes" the Unclassified row to contain string in all lineage columns <--## 


rule tax_ktImportText:
    input:
        ancient(expand(rules.tax_kreport2krona_per_sample.output.binfile, sample=samples))
    output:
        TAXPLOTS
    shell:
        "ktImportText {input} -o {output}"





# Step 4 starts
rule remove_rRNA:
    input:
        log=rules.run_kraken2_decontaminate.output.outlog,
        fwdgz=ancient(rules.run_kraken2_decontaminate.output.fwdted),
        revgz=ancient(rules.run_kraken2_decontaminate.output.revted),
    params:
        f=ancient(rules.run_kraken2_decontaminate.params.fte),
        r=ancient(rules.run_kraken2_decontaminate.params.rte),
        ali_log = TED_READS  + "{sample}_rna_filter_LOG.txt",
    output:
        fread_gz=TED_READS_FQS + "{sample}_R1_tedr.fastq.gz",
        rread_gz=TED_READS_FQS + "{sample}_R2_tedr.fastq.gz",
    threads: threads_per_job
    conda:
        "ribodetector"
    shell:"""
        if [[ -s {params.f} ]]; then 
            ribodetector_cpu -t {threads} -l 100 --chunk_size 3200 -e norrna \
                -i {params.f} {params.r}  --log {params.ali_log} \
                -o {output.fread_gz} {output.rread_gz} 
        else 
            ribodetector_cpu -t {threads} -l 100 --chunk_size 3200 -e norrna \
                -i {input.fwdgz} {input.revgz}  --log {params.ali_log} \
                -o {output.fread_gz} {output.rread_gz} 
        fi


        sed -i 's/\\\x1b\[[0-9;]*m//g' {params.ali_log}

        line_count=$(pigz -dc -p {threads} {output.fread_gz} | wc -l )
        if [ "$line_count" -lt 400 ]; then
            echo "---- FAIL: Fewer than 100 reads remain after rRNA filtering for {wildcards.sample}. Reads are unlikely to assemble. 
            If this dataset is rRNA amplicon reads, consider using our DADA2 or QIIME pipelines."
            exit
        fi
        """

if config["read_norm"]:
    rule norm_readDepth:
        resources:
            mem_gb = lambda wildcards: int(config['total_mem_gb'] // 4)
        input:
            Freads = lambda wildcards: rules.remove_rRNA.output.fread_gz if config["denovo_mtx"] else rules.run_kraken2_decontaminate.output.fwdted,
            Rreads = lambda wildcards: rules.remove_rRNA.output.rread_gz if config["denovo_mtx"] else rules.run_kraken2_decontaminate.output.revted,
        params:
            maxCov=config["readCoverage"],
            logfile=TED_READS + "{sample}_normLog.txt",
            mem_gb = "-Xmx" + str(int(config['total_mem_gb'] // 4)) + "g"
        output:
            normFread = (TED_READS_FQS + "{sample}_ted_norm_R1.fastq.gz"),
            normRread = (TED_READS_FQS + "{sample}_ted_norm_R2.fastq.gz"),
        threads: threads_per_job
        shell:"""
            bbnorm.sh {params.mem_gb} target={params.maxCov}  in={input.Freads} in2={input.Rreads} ecc=f prefilter=f \
                             out={output.normFread} out2={output.normRread}  threads={threads} &> {params.logfile}
            """


rule run_metaspades:
    input:
        in1=lambda wildcards: (rules.norm_readDepth.output.normFread if config["read_norm"] else rules.run_kraken2_decontaminate.output.fwdted),
        in2=lambda wildcards: (rules.norm_readDepth.output.normRread if config["read_norm"] else rules.run_kraken2_decontaminate.output.revted),
        req=lambda wildcards: (rules.TAX_diversity_plots.output.logR if len(samples) >1     else []),   
    resources:
        mem_gb=int(config['total_mem_gb'])
    params:
        mem_gb=int(config['total_mem_gb']),
        out=ASMB_OUT_SAMPLE_DIR,
        ## temp asmb files
        tmp_dir=temp(TMP_SAMPLE_DIR + "_asmb/"),
        scafout=temp(TMP_SAMPLE_DIR + "_asmb/" + "scaffolds.fasta"),
        contout=temp(TMP_SAMPLE_DIR + "_asmb/" + "contigs.fasta"),
        grafout=temp(TMP_SAMPLE_DIR + "_asmb/" + "assembly_graph_with_scaffolds.gfa"),
        mspalog=temp(TMP_SAMPLE_DIR + "_asmb/" + "spades.log"),
        ## marker files
        passout=ASMB_OUT_SAMPLE_DIR + "_asmb.pass",
        failout=ASMB_OUT_SAMPLE_DIR + "_asmb.fail",
        ## final files
        grfout= ASMB_OUT_SAMPLE_FILE + "_asmbFinal.gfa",
        scfout= ASMB_OUT_SAMPLE_FILE + "_scaffolds.fasta",
        cntout= ASMB_OUT_SAMPLE_FILE + "_contigs.fasta",
        logout= ASMB_OUT_SAMPLE_FILE + "_spadesLOG.txt",
        asmbout=ASMB_TMP_FINASM_FILE,  ##"_tmp_finAsmb.txt" needed for run_bbtools_stats proper unpackaging
    threads: config["num_cpus"] ##threads_per_job
    output:
        doneout=     ASMB_OUT_SAMPLE_DIR + "_MGXasmb.done",
    shell:"""
        time metaspades.py -1 {input.in1} -2 {input.in2}  --memory {params.mem_gb} \
            --tmp-dir {params.tmp_dir} -o {params.tmp_dir} -t {threads} \
            --only-assembler  > {params.logout} 2>&1 && \
        touch {output.doneout} 
        
        if [[ -s {params.scafout} ]]; then  
                    cp {params.grafout} {params.grfout} && \
                    cp {params.contout} {params.cntout} && \
                    cp {params.scafout} {params.scfout} && \
                    cp {params.scafout} {params.asmbout} && \
                    touch {params.passout}  
                    echo "---- PASS: scaffold assembly achieved for {wildcards.sample}"
        elif [[ -s {params.contout} ]]; then
                    cp {params.contout} {params.cntout} && \
                    cp {params.contout} {params.asmbout} && \
                    touch {params.passout} && \
                    echo "---- PASS: contig assembly achieved for {wildcards.sample}"
        else 
                    echo ">no_assembly produced" > {params.asmbout} && \
                    touch {params.failout}     && \
                    echo "---- ERROR in rule run_metaspades::" && \
                    echo "---- FAIL: assembly failed for {wildcards.sample}" && \
                    echo "---- processing will continue for other samples as much as possible"   
        fi
        
        tail -n 30 {params.logout}
        """

rule run_trinity:
    resources:
        mem_gb=lambda wildcards: int(config['total_mem_gb'] // 3)
    input:
        f=lambda wildcards: (rules.norm_readDepth.output.normFread if config["read_norm"] else rules.remove_rRNA.output.fread_gz),
        r=lambda wildcards: (rules.norm_readDepth.output.normRread if config["read_norm"] else rules.remove_rRNA.output.rread_gz),
        q=lambda wildcards: (rules.TAX_diversity_plots.output.logR if len(samples) >1     else []),         
    threads: config["num_cpus"]
    params:
        tmpDir=TMP_SAMPLE_DIR + "_trinity_asmb/",
        fasout=TMP_DIR + "{sample}_trinity_asmb.Trinity.fasta",
        memrGb=str(config['total_mem_gb'] // 3) + "G",
        threads = lambda wildcards: int(config["num_cpus"] - 8),
        bfly_CPU=2,
        bfly_HeapSpace="20G",
        ## marker files
        passout=ASMB_OUT_SAMPLE_DIR + "_asmb.pass",
        failout=ASMB_OUT_SAMPLE_DIR + "_asmb.fail",
        ## final files
        cntout= ASMB_OUT_SAMPLE_FILE + "_contigs.fasta",
        logout= ASMB_OUT_SAMPLE_FILE + "_trinityLOG.txt",
        asmbout=ASMB_TMP_FINASM_FILE,  ## "_tmp_finAsmb.txt" needed for run_bbtools_stats proper unpackaging
    output:
        doneout=     ASMB_OUT_SAMPLE_DIR + "_MTXasmb.done",
    shell:"""
        time Trinity --seqType fq --left {input.f} --right {input.r} --CPU {params.threads} \
            --output {params.tmpDir} --full_cleanup --max_memory {params.memrGb} \
            --bflyHeapSpaceMax {params.bfly_HeapSpace} --bflyCPU {params.bfly_CPU} > \
            {params.logout} 2>&1 && touch {output.doneout}

        if [[ -s {params.fasout} ]]; then 
                    cp {params.fasout} {params.cntout} && \
                    cp {params.fasout} {params.asmbout} && \
                    touch {params.passout} ## needs to be empty
                    echo "---- PASS: assembly passed for {wildcards.sample}"
        else 
                    echo ">no_assembly produced" > {params.asmbout} && \
                    touch {output.doneout} && touch {params.failout} && \
                    echo "---- ERROR in rule run_trinity::" && \
                    echo "---- FAIL: assembly failed for {wildcards.sample}" && \
                    echo "---- processing will continue for other samples as much as possible" 
        fi
        tail -n 30 {params.logout} | grep -v "succeeded"
        """

rule run_bbtools_stats: ## this rule _needs_ a file to expand
    input:
        doneout=lambda wildcards: (rules.run_trinity.output.doneout    if config["denovo_mtx"] 
                           else rules.run_metaspades.output.doneout),
    params:
        asm     =ASMB_OUT_SAMPLE_DIR,
        passmark=ASMB_OUT_SAMPLE_DIR  + "_asmb.pass",
        asmbfas1=ASMB_TMP_FINASM_FILE,  # ASMB_OUT_SAMPLE_DIR + "_tmp_finAsmb.txt",
        ## fake files for PWY_collation rule
        fake_dir1=GENEBIN, ## touch needs the PATH pre-made
        fake_dir2=PWYBIN,  ## touch needs the PATH pre-made
        fake_tpm1=temp(GENEBIN + "{sample}_geneTPMtab." + ANNO_TYPE + ".txt"), 
        fake_krn2=temp(PWYBIN  + "{sample}_4krona.txt"),
    output:
        finfasta=ASMB_OUT_SAMPLE_FILE + "_asmbFinal.fasta",
        finstats=ASMB_OUT_SAMPLE_FILE + "_asmbStats.txt",
    shell:"""
        if [[ -e {params.passmark} ]]; then  ## exists
            sed $'s/_cov_/ cov_/g' {params.asmbfas1} > {output.finfasta} && \
            stats.sh in={output.finfasta} out={output.finstats} && \
            printf \"\\nTEDreads mapping stats:\\n\"  >> {output.finstats}
        else
            echo "---- FAIL: no assembly produced" >> {output.finstats}
            mv {params.asmbfas1} {output.finfasta}
            mkdir -p {params.fake_dir1} && mkdir -p {params.fake_dir2}
            touch {params.fake_tpm1} {params.fake_krn2}
        fi
    """



# Step 5 starts
rule run_bowtie2:
    input:
        oristat=ancient(expand(rules.run_bbtools_stats.output.finstats, sample = samples )),
        in1=lambda wildcards: rules.remove_rRNA.output.fread_gz if config["denovo_mtx"] else rules.run_kraken2_decontaminate.output.fwdted,
        in2=lambda wildcards: rules.remove_rRNA.output.rread_gz if config["denovo_mtx"] else rules.run_kraken2_decontaminate.output.revted,
    params:
        DBname=TMP_SAMPLE_DIR + "_asmb/" + "{sample}.db", ## so bt2 tmp files dont get overwritten
        finfasta=rules.run_bbtools_stats.output.finfasta,
        finstats=rules.run_bbtools_stats.output.finstats, #  its both input and output
        passmark=ASMB_OUT_SAMPLE_DIR  + "_asmb.pass",
    threads: threads_per_job
    output:
        samfile=temp(TMP_SAMPLE_DIR + "_asmb/" + "_tmp.sam"),
        bt2done=temp(ASMB_OUT_SAMPLE_DIR + "_bt2run.done"), 
    shell:"""
        if [[ -e {params.passmark} ]]; then  ## just ensure existance or bt2 errors
            bowtie2-build --quiet --threads {threads} {params.finfasta} {params.DBname} 
            bowtie2 --phred33 --sensitive-local --no-unal --seed 4 \
                -1 {input.in1} -2 {input.in2} -x {params.DBname} \
                -S {output.samfile} -p {threads} 2>> {params.finstats} && touch {output.bt2done}
        else true
        fi
    """

 

rule sam_to_bam:
    input:
        samfile=rules.run_bowtie2.output.samfile,
        bt2fin =rules.run_bowtie2.output.bt2done,
    params:
        bam_srtorig=TMP_SAMPLE_DIR + "_asmb/" + "_srtorig.bam",
        prefix_mdup=TMP_SAMPLE_DIR + "_asmb/" + "_markdup",
        bam_initial=TMP_SAMPLE_DIR + "_asmb/" + "_initial.bam",
        bam_colated=TMP_SAMPLE_DIR + "_asmb/" + "_colated.bam",
        bam_fixmate=TMP_SAMPLE_DIR + "_asmb/" + "_fixmate.bam",
        bam_srtfixd=TMP_SAMPLE_DIR + "_asmb/" + "_srtfixd.bam",
        bam_fixsrtd=TMP_SAMPLE_DIR + "_asmb/" + "_fixsrtd.bam",
        tmp_mrkdp  =TMP_SAMPLE_DIR + "_asmb/" + "_markdup.txt",
    threads: threads_per_job
    output:
        final_bam=ASMB_OUT_SAMPLE_FILE      + "_asmbFinal.bam",
        bam_index=ASMB_OUT_SAMPLE_FILE      + "_asmbFinal.bam.bai",
    shell:
        "samtools sort {input.samfile} -o {params.bam_initial} -@ {threads} -T {params.bam_srtorig} && "
        "samtools collate {params.bam_initial} -o {params.bam_colated} -@ {threads} {params.bam_colated} && "
        "samtools fixmate -m {params.bam_colated} {params.bam_fixmate} -@ {threads} && "
        "samtools sort {params.bam_fixmate} -o {params.bam_fixsrtd} -@ {threads} -T {params.bam_srtfixd} && "
        "samtools markdup -r -s {params.bam_fixsrtd} -f {params.tmp_mrkdp} {output.final_bam} -@ {threads} -T {params.prefix_mdup} && "
        "samtools index -b {output.final_bam} -@ {threads}"

rule add_derep_stats:
    input:
        in1=ancient(rules.run_bbtools_stats.output.finstats),
        req=rules.sam_to_bam.output.final_bam,
    params:
        in2=rules.sam_to_bam.params.tmp_mrkdp,
        stats_file=ancient(ASMB_OUT_SAMPLE_FILE + "_asmbStats.txt"),
        tmp_out   =ASMB_OUT_SAMPLE_FILE + "_tmp_file.txt"
    output:
        # to signal this step is completed
        ASMB_OUT_SAMPLE_DIR + "_added_derep_stats.done"
    shell:
        "cat {input.in1} <(printf \"\\nRead alignment de-replication stats:\\n\") {params.in2} > {params.tmp_out} && "
        "mv {params.tmp_out} {params.stats_file} && touch {output}"


rule scaffold_and_read_counts:
    resources:
        mem_gb=lambda wildcards: int(config['total_mem_gb'] // 4)
    input:
        final_bam=rules.sam_to_bam.output.final_bam
    params:
        mem_gb = "-Xmx" + str(int(config['total_mem_gb'] // 4)) + "g",
        finstatsADD=ancient(rules.run_bowtie2.params.finstats),
        tmp_scafcov=TMP_SAMPLE_DIR + "_asmb/" + "_tmp_scafcov.txt",
        tmp_basecov=TMP_SAMPLE_DIR + "_asmb/" + "_tmp_basecov.txt",
        tmp_fileidx=TMP_SAMPLE_DIR + "_asmb/" + "_tmp_fileidx",
        tmp_readcnt=TMP_SAMPLE_DIR + "_asmb/" + "_tmp_readcount.txt",
        tmp_scfcov1=TMP_SAMPLE_DIR + "_asmb/" + "_tmp_scfcov1.txt",
    output:
        out_depths =     ASMB_OUT_SAMPLE_FILE + "_asmbDepths.txt",
        out_scfCovr=     ASMB_OUT_SAMPLE_FILE + "_asmbCovr.txt",
    shell:"""
        printf \"\\n\\nRead Coverage stats: \\n\" >> {params.finstatsADD}
        pileup.sh {params.mem_gb} {input.final_bam} out={params.tmp_scafcov} overwrite=true 2>> {params.finstatsADD} && \
        sort -o {params.tmp_scafcov} {params.tmp_scafcov} && \
        jgi_summarize_bam_contig_depths {input.final_bam} --outputDepth {output.out_depths} && \
        sort {output.out_depths} | sed '1 s/^/#/' | cut -f 1-3 > {params.tmp_basecov} && \
        samtools idxstats {input.final_bam} > {params.tmp_fileidx} 
        
        cut -f 1-3 {params.tmp_fileidx} | sed -e '1s/^/#contigName\\tLength\\tReadsCount\\n/' | sort | grep -v \"*\" > {params.tmp_readcnt} && \
        paste {params.tmp_readcnt} {params.tmp_scafcov} {params.tmp_basecov} | cut -f 1,2,3,8-14,17 -d $'\\t' > {params.tmp_scfcov1} 
        
        awk 'BEGIN{{FS=OFS=\"\\t\"}} NR>1 {{if ($2>0 && $3>0) $12=sprintf(\"%0.2f\", $3*1e3/$2); else $12=0; print}}'  {params.tmp_scfcov1} | \
            sed -e '1s/^/#NODE\\tlen\\tReads\\t\%NodeCovered\\t\%bpCovered\\tplusReads\\tminusReads\\t\%GC\\tMedFold\\tstDev\\tAveDepth\\tRPK\\n/' > \
            {output.out_scfCovr}
        """


# Step 6 starts
rule gene_prediction:
    input:
        finfas=rules.run_bbtools_stats.output.finfasta,
        require=rules.scaffold_and_read_counts.output.out_scfCovr, 
    threads: threads_per_job
    output:
        gff=PREGENES_PREFIX + ".gff",
        faa=PREGENES_PREFIX + ".faa",
        fna=PREGENES_PREFIX + ".fna"
    shell:
        "prodigal -p meta -i {input.finfas} -f gff -o {output.gff} -a {output.faa} -d {output.fna} -q"

rule gff_to_gtf:
    input:
        rules.gene_prediction.output.gff
    params:
        gff2gtf_script=config["gff2gtf_script"]
    output:
        PREGENES_PREFIX + ".gtf"
    shell:
        "{params.gff2gtf_script} {input} > {output}"

rule run_verse:
    input:
        gtf=rules.gff_to_gtf.output,
        final_bam=rules.sam_to_bam.output.final_bam
    threads: threads_per_job
    params:
        basename=GENES + "verse",
        versesum=GENES + "verse.CDS.summary.txt", ## was output.out1
        verselog=GENES + "verse_runLOG.txt",
    output:
        out2=temp(GENES + "verse.CDS.txt"),
        out3=PREGENES_PREFIX + "_stats.txt"
    shell:"""
        verse -a {input.gtf} -t 'CDS' -g gene_id -z 0 -s 0 \
        -o {params.basename} {input.final_bam} -T 4 > {params.verselog} 2>&1 
        mv {params.versesum} {output.out3}
        """


rule tpm_normalization:
    input:
        gtf=rules.gff_to_gtf.output,
        verse_cds=rules.run_verse.output.out2
    params:
        tmp_lens=TMP_SAMPLE_DIR + "_asmb/_tmp_gene_lengths.txt",
        tmp_cnts=TMP_SAMPLE_DIR + "_asmb/_tmp_gene_counts.txt",
        tmp_cvrg=TMP_SAMPLE_DIR + "_asmb/_tmp_gene_coverage.txt",
        tmp_rpk =TMP_SAMPLE_DIR + "_asmb/_tmp_gene_RPK.txt",
    output:
        ABUNtab =PREGENES_PREFIX + "_ABUNtab.txt"
    shell:
        "cut -f4,5,9 {input.gtf} | sed 's/gene_id //g' | gawk '{{print $3,$2-$1+1}}' | tr ' ' '\\t' | sed '1s/^/gene\\tlength\\n/' > {params.tmp_lens} && "
        "join {params.tmp_lens} {input.verse_cds} -t $'\\t' > {params.tmp_cnts} && "
        "grep \"_\" {params.tmp_cnts} | awk -v OFS=\"\\t\" '{{$4 = sprintf(\"%0.0f\", $3*150/$2)}}1' | sort | sed -e '1s/^/#name\\tlen\\treads\\tcov\\n/'       > {params.tmp_cvrg} && "
        "grep \"_\" {params.tmp_cvrg} | awk -v OFS=\"\\t\" '{{$5 = sprintf(\"%0.0f\", $3*1e3/$2)}}1' | sort | sed -e '1s/^/#name\\tlen\\treads\\tcov\\tRPK\\n/' > {params.tmp_rpk}  && "
        "awk -v OFS=\"\\t\" 'NR==FNR{{sum+= $5; next}} FNR==1{{print $0,\"iTPM\"; next}} {{printf(\"%s %0.0f\\n\", $0,$5*1e6/sum)}}'  {params.tmp_rpk} {params.tmp_rpk} |sed -e 's/\\s/\\t/g' > {output.ABUNtab}  "



# Step 7 starts
rule gene_annotation:
    resources:
        mem_gb=config["total_mem_gb"] # make sure not run out of memory
    input:
        ancient(rules.gene_prediction.output.faa),
    threads: config["num_cpus"], ##threads_per_job
    params:
        egg_db=config["eggnog_db"],
        out_dir=ANNOTATS,
        tmp_dir=TMP_DIR,
        blockSize=24, ##16 is good,
        idxChunks=1, ## keep to 1,
        logfile=ANNOTATS + "emapperLOG.txt",
        emapper_hits=ANNOTATS + "annots.emapper.hits",
        emapper_seed=ANNOTATS + "annots.emapper.seed_orthologs",
        emapper_anno=ANNOTATS + "annots.emapper.annotations"
    output:
        ec=ANNOTATS + "{sample}_annots.ec.txt",
        ko=ANNOTATS + "{sample}_annots.ko.txt",
        gg=ANNOTATS + "{sample}_annots.KEGGmap.txt"
    conda:
        "eggnog_mapper"
    shell:"""
        time emapper.py -i {input} -o annots --output_dir {params.out_dir} --cpu {threads} \
                --itype proteins --block_size {params.blockSize} --index_chunks {params.idxChunks} --data_dir {params.egg_db}  \
                --override --temp_dir {params.tmp_dir}  --scratch_dir {params.tmp_dir} --dbmem >> {params.logfile} 2>&1 

        if [[ ! -s {params.emapper_anno} ]]; then 
            echo "---- FAIL: no gene annotations were produced for {wildcards.sample}" && exit 0
        else 
            echo "---- PASSED: gene annotations for {wildcards.sample} finished successfully" 
        fi

        ## grep needed terms
        grep -E \"NODE_|TRINITY_\" {params.emapper_anno} | cut -f 1,11 | sed -e 's/\\t-//g' | grep -e $'\\t' | \
                awk '{{n=split($2,s,\",\");for (i=1;i<=n;i++) {{$2=s[i];print}}}}' | sed -e 's/\\s/\\t/g' > {output.ec} || true

        grep -E \"NODE_|TRINITY_\" {params.emapper_anno} | cut -f1,12 | grep \"ko:\" | sed 's/ko://g' | \
                awk '{{n=split($2,s,\",\");for (i=1;i<=n;i++) {{$2=s[i];print}}}}' | sed -e 's/\\s/\\t/g' > {output.ko} || true

        grep -E \"NODE_|TRINITY_\" {params.emapper_anno} | cut -f1,13 | grep \"ko\" | sed 's/,map.*//g' | sed 's/ko/map/g' | \
                awk '{{n=split($2,s,\",\");for (i=1;i<=n;i++) {{$2=s[i];print}}}}' | sed -e 's/\\s/\\t/g' > {output.gg} || true
        """


rule gene_annot_seqExtract:
    input: 
        faa=rules.gene_prediction.output.faa,
        fna=rules.gene_prediction.output.fna,
        kos=rules.gene_annotation.output.ko,
        ecs=rules.gene_annotation.output.ec
    output:
        kofaa=ANNOTATS + "{sample}_annots.ko.faa",
        kofna=ANNOTATS + "{sample}_annots.ko.fna",
        ecfaa=ANNOTATS + "{sample}_annots.ec.faa",
        ecfna=ANNOTATS + "{sample}_annots.ec.fna"
    shell:
        """
        seqtk subseq {input.faa} {input.kos} > {output.kofaa}
        seqtk subseq {input.fna} {input.kos} > {output.kofna}
        seqtk subseq {input.faa} {input.ecs} > {output.ecfaa}
        seqtk subseq {input.fna} {input.ecs} > {output.ecfna}
        """
    


rule gene_annot_iTPMs:
    input:
        abufile=rules.tpm_normalization.output.ABUNtab, 
        grp_kos=rules.gene_annotation.output.ko,
        grp_ecs=rules.gene_annotation.output.ec
    output:
        abukos=ANNOTATS + "ANNOTgenes_ABUNtab.ko.txt",
        abuecs=ANNOTATS + "ANNOTgenes_ABUNtab.ec.txt"
    shell:"""
            awk -v OFS=\"\\t\" 'NR==FNR {{ id[$1]=$0; next }} ($1 in id){{ print $2, id[$1]}}'  {input.abufile} {input.grp_kos} | \
                sed '1s/^/#KO\\tnodeID\\tlen\\treads\\tcov\\tiRPK\\tiTPM\\n/' > {output.abukos}
            awk -v OFS=\"\\t\" 'NR==FNR {{ id[$1]=$0; next }} ($1 in id){{ print $2, id[$1]}}'  {input.abufile} {input.grp_ecs} | \
                sed '1s/^/#KO\\tnodeID\\tlen\\treads\\tcov\\tiRPK\\tiTPM\\n/' > {output.abuecs}        
        """

rule gene_annot_geneTPMs:
    input:
        abukos=rules.gene_annot_iTPMs.output.abukos,
        abuecs=rules.gene_annot_iTPMs.output.abuecs
    params:
        awk_geneTPM_script=config["awk_geneTPM_script"],
        awk_joinTPM_script=config["awk_joinTPM_script"],
        KO_list=config["KO_listfile"],
        EC_list=config["EC_listfile"]
    output:
        tmpko=temp(ANNOTATS +     "_tmp_geneTPMtab.ko.txt"),
        TPMko=     ANNOTATS + "{sample}_geneTPMtab.ko.txt",
        tmpec=temp(ANNOTATS +     "_tmp_geneTPMtab.ec.txt"),
        TPMec=     ANNOTATS + "{sample}_geneTPMtab.ec.txt"
    shell:"""
        cut -f1,7 {input.abukos} | sed $'s/#KO.*//g' | awk -F'\\t' -f {params.awk_geneTPM_script} > {output.tmpko}
        awk -F'\\t' -f {params.awk_joinTPM_script} {params.KO_list} {output.tmpko} | \
        sed '1s/^/#KO\\tgeneTPM\\tgeneNAME\\n/'> {output.TPMko}

        cut -f1,7 {input.abuecs} | sed $'s/#EC.*//g' | awk -F'\\t' -f {params.awk_geneTPM_script} > {output.tmpec}
        awk -F'\\t' -f {params.awk_joinTPM_script} {params.EC_list} {output.tmpec} | \
        sed '1s/^/#EC\\tgeneTPM\\tgeneNAME\\n/'> {output.TPMec}
        """

rule cp_geneTPM_files:
    input: 
        kos=rules.gene_annot_geneTPMs.output.TPMko,
        ecs=rules.gene_annot_geneTPMs.output.TPMec,
    params:
        out_dir=GENEBIN
    output:
        GENEBIN + "{sample}_geneTPMtab." + ANNO_TYPE + ".txt",
    run:
        if config["annotations_type"] == "ko":
            shell("cp {input.kos} {params.out_dir} || touch {output}")
        else:
            shell("cp {input.ecs} {params.out_dir} || touch {output}")


# Step 8 starts (pwy predictions)
rule copy_annotation_file:
    input:
        ko=rules.gene_annotation.output.ko,
        ec=rules.gene_annotation.output.ec,
        ABUNtab=rules.tpm_normalization.output.ABUNtab
    output:
        tmp_ann=temp(PATHWAYS + "_tmp_annots.txt"),
        tmp_TPM=temp(PATHWAYS + "_tmp_TPM.txt")
    run:
        if config["annotations_type"] == "ko":
            shell("cp {input.ko} {output.tmp_ann} && cut -f 1,5 {input.ABUNtab} > {output.tmp_TPM}")
        else:
            shell("cp {input.ec} {output.tmp_ann} && cut -f 1,5 {input.ABUNtab} > {output.tmp_TPM}")

rule run_min_path:
    input:
        ancient(rules.copy_annotation_file.output.tmp_ann),
    params:
        minpath_script=config["minpath_script"],
        annotations_map=config["annotations_map"],
        minpath_log=PATHWAYS_PREFIX + ".minpath.log.txt",
        mps_file=PATHWAYS_PREFIX + ".mps",
        minpath_mpt=PATHWAYS_PREFIX + "_tmp_missing_pathways.txt" ## where is this outputting?
    output:
        tmp_report=temp(PATHWAYS + "_tmp_report.txt"),
        details=PATHWAYS_PREFIX + ".details.txt"
    shell:"""
        if [ -s {input} ]; then
            python3 {params.minpath_script} -any {input} -map {params.annotations_map} -mps {params.mps_file} \
                -report {output.tmp_report} -details {output.details} >> {params.minpath_log} || \
                echo "---- FAIL: No pathways found based on the available annotations in {wildcards.sample}" | \
                tee -a {params.minpath_log} {output.details} > /dev/null && \
                touch {output.tmp_report} ## needs to be empty
            # rm {params.minpath_mpt}
        else
            echo "---- FAIL: No annotations found to infer pathways for {wildcards.sample}" | \
            tee -a {output.details} {params.minpath_log} && \
            touch {output.tmp_report}
        fi
        """
        ## tee -a appends the 3 files


rule create_pathways_report:
    input:
        rules.run_min_path.output.tmp_report
    output:
        PATHWAYS_PREFIX + ".report.txt"
    shell: """
        if [ -s {input} ]; then
            grep 'minpath\ 1' {input} > {output}
        else
            touch {output} ## needs to be empty
        fi
        """



rule run_genes2krona:
    input:
        tmp_annots=rules.copy_annotation_file.output.tmp_ann,
        tmp_TPM=rules.copy_annotation_file.output.tmp_TPM,
        report=rules.create_pathways_report.output
    params:
        krona_script=config["genes2krona_script"],
        annotations_map=config["annotations_map"],
        annotations_hrr=config["annotations_hrr"],
        pwybin=PWYBIN,
    output:
        tmp_4kr=   temp(PATHWAYS + "_tmp_4kr.txt"),
        krona_out=      PATHWAYS + "{sample}_4krona.txt",
        krona_out_clone=PWYBIN   + "{sample}_4krona.txt"
    shell:"""
        if [ -s {input.tmp_annots} -a -s {input.tmp_TPM} -a -s {input.report} ]; then
            python3 {params.krona_script} -i {input.tmp_annots}\
                -m {params.annotations_map} -H {params.annotations_hrr} \
                -n {wildcards.sample} -c {input.tmp_TPM}\
                -l {input.report} -o {output.tmp_4kr} &&\
            sed '1s/^/#/' {output.tmp_4kr} > {output.krona_out} &&\
            cp {output.krona_out} {output.krona_out_clone}
        else
            echo "---- FAIL: No annotations or pathways found for {wildcards.sample}, so pwybin krona file will be empty" &&\
            touch {output.tmp_4kr} {output.krona_out} && mkdir -p {params.pwybin} &&\
            touch {output.krona_out_clone}
        fi
        """

rule gene_ktImportText:
