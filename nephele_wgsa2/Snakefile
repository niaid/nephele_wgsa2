import subprocess
onsuccess:
    shell(clean_output() + handle_TED() + handle_cp_biom() + main_outputs() ) 
    subprocess.run(fwd_outputs(), shell = True ) ## for DiscoVIR and MAGs pipeline
    #shell("cp {log} {outputs_dir}/.snakemake.log")
onerror:
    shell(clean_output() + handle_TED() + handle_cp_biom() + main_outputs() )
    subprocess.run(fwd_outputs(), shell = True ) ## for DiscoVIR and MAGs pipeline
    #shell("cp {log} {outputs_dir}/.snakemake.log")
