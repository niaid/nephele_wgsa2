# Step 6A starts
if config["tax_genes"]:
    rule tax_classification_genes:
        resources:
            mem_gb=config["total_mem_gb"]
        input:
            fna=rules.gene_prediction.output.fna
        threads: threads_per_job
        params:
            classification_db=config["classification_db"],
            confidence_taxon=config["kr2confidence_taxonomic"],
        output:
            klog=temp(GENETAX_PREFIX + "_klog.txt"), ## needed for genes
            report=GENETAX_PREFIX + "_taxREPORT.txt",
            outlog=GENETAX_PREFIX + "_classLOG.txt"
            # classified_out=GENETAX_PREFIX + "_classified.fna",
            # unclassified_out=GENETAX_PREFIX + "_unclassified.fna"
        shell:
            "kraken2 --use-names --threads {threads}  --db {params.classification_db} "
            "--confidence {params.confidence_taxon} {input.fna} --memory-mapping "
            "--output {output.klog} "
            "--report {output.report} 2>> {output.outlog}"
            # "--classified-out {output.classified_out} "
            # "--unclassified-out {output.unclassified_out}"

    rule tax_genes_ABUNtabtax:
        input:
            klog=rules.tax_classification_genes.output.klog,
            ABUNtab=rules.tpm_normalization.output.ABUNtab
        output:
            tmptax=temp(GENETAX_PREFIX + "_tmptax.txt"),
            ABUNtax=GENETAX_PREFIX + "_ABUNtab_wTAX.txt"
        shell:
            "cut -f2-3 {input.klog} | sed -e 's/ (taxid /\\t/g' | sed -e 's/)$//g' | sort | "
            "sed '1s/^/#contigName\\tTAXname\\tTAXid\\n/' > {output.tmptax} &&"
            "paste {input.ABUNtab} <(cut -f2-3 {output.tmptax}) > {output.ABUNtax} "

    # if DBNAME == "mgbcDB":
    #     rule omit_krona:
    #         output:
    #             done=temp(GENETAX_PREFIX + "_omittingKrona.done")
    #         shell:
    #             """
    #             print("---> krona plots omitted for selected classification DB")
    #             touch {output.done}
    #             """
    # else:
    rule tax_genes_4krona:
        input:
            ABUNtax=rules.tax_genes_ABUNtabtax.output.ABUNtax
        output:
            out_4krona=GENETAX + "bin/{sample}_4krona.txt"
        shell:
            "cut -f6-8 {input.ABUNtax} | awk -F'\\t' 'NR>1{{k = $3; sum[k]+= $1; name[k]=$2}} END {{ print; for (k in sum) print sum[k], name[k], k}}' OFS=\"\t\" |"
            "sed -e '1 s/^/#iTPM\\tTAXname\\tTAXid\\n/' > {output.out_4krona}"

    rule kt_genetax_html:
        input:
            expand(rules.tax_genes_4krona.output.out_4krona, sample=samples)
        params:
            krona_tax_db=config["krona_tax_db"]
        output:
            GENETAX + "TAXplots_genesTAX_" + DBNAME + ".html"
        shell:
            "ktImportTaxonomy {input} -m 1 -q 2 -t 3 -d 10 -tax {params.krona_tax_db} -o {output}"


# Step 6B starts
if config["tax_scaffolds"]:
    rule tax_classification_scaffolds:
        resources:
            mem_gb=config["total_mem_gb"]
        input:
            finfas=rules.run_bbtools_stats.output.finfasta,
            require=expand(rules.scaffold_and_read_counts.output.out_scfCovr, sample=samples), ##processing organization
        threads: threads_per_job
        params:
            classification_db=config["classification_db"],
            confidence_taxon=config["kr2confidence_taxonomic"],
        output:
            klog=temp(SCAFTAX_DIR + "_klog.txt"),
            report=SCAFTAX_PREFIX + "_taxREPORT.txt",
            outlog=SCAFTAX_PREFIX + "_classLOG.txt"
        shell:
            "kraken2 --use-names --db {params.classification_db} --confidence {params.confidence_taxon} --memory-mapping "
            "--threads {threads} {input.finfas} --output {output.klog} --report {output.report} 2>> {output.outlog}"

    rule generate_scaftax:
        input:
            klog=rules.tax_classification_scaffolds.output.klog,
            scov=rules.scaffold_and_read_counts.output.out_scfCovr
        output:
            scovtax=SCAFTAX_PREFIX + "_asmbCovr_wTAX.txt",
            tmp=temp(SCAFTAX_DIR   + "_tmp_tax.txt")
        shell:
            "cut -f2-3 {input.klog} | sed -e 's/ (taxid /\\t/g' | sed -e 's/)$//g' | sort | "
            "sed '1s/^/#contigName\\tTAXname\\tTAXid\\n/' > {output.tmp} && "
            "paste {input.scov} <(cut -f2-3 {output.tmp}) > {output.scovtax}"


    rule tax_scafs_4krona:
        input:
            scovtax=rules.generate_scaftax.output.scovtax
        output:
            out_4krona=SCAFTAX + "bin/{sample}_4krona.txt"
        shell:
            "cut -f12,13,14 {input.scovtax} | "
            "awk -F'\\t' 'NR>1{{k = $3; sum[k]+= $1; name[k]=$2}} END {{ print; for (k in sum) print sum[k], name[k], k}}' OFS=\"\t\" |"
            "sed -e '1 s/^/#RPK\\tTAXname\\tTAXid\\n/' > {output.out_4krona}"

    rule kt_scaftax_html:
        input:
            expand(rules.tax_scafs_4krona.output.out_4krona, sample=samples)
        params:
            krona_tax_db=config["krona_tax_db"]
        output:
            SCAFTAX + "TAXplots_scaffTAX_" + DBNAME + ".html" ## approximate bundnaces
        shell:
            "ktImportTaxonomy {input} -m 1 -q 2 -t 3 -d 10 -tax {params.krona_tax_db} -o {output}"



# Step 6C starts
if config["mag"]:
    rule metabat2_run:
        input:
            fasta=rules.run_bbtools_stats.output.finfasta,
            depths=rules.scaffold_and_read_counts.output.out_depths
        threads: threads_per_job
        params:
            basename=MAG + "mag"
        output:
            temp(MAG + "_metabat2_run.done")
        shell:
            "metabat2 -i {input.fasta} -o {params.basename} -m 1500 --maxEdges 250 "
            "--unbinned  -t {threads} -a {input.depths} && touch {output}"

    rule checkm_lineage_wf:
        resources:
            mem_gb=config["total_mem_gb"],
        threads: config["num_cpus"]
        input:
            # We do not use the actual output here but need files from metabat2_run step
            rules.metabat2_run.output
        params:
            ftype="fa",
            basename=MAG,
            out=MAG_QA
        output:
            MAG_QA + "lineage.ms"
        log:
            MAG_QA + "checkmLOG.txt"
        conda:
            "checkm"
        shell:
            "checkm lineage_wf --tab_table --nt --pplacer_threads {threads} "
            "-t {threads} -x {params.ftype} {params.basename} {params.out} > {log} 2>&1"

    rule checkm_qa:
        input:
            rules.checkm_lineage_wf.output
        params:
            mag_qa=MAG_QA
        threads: config["num_cpus"]
        output:
            qa_txt=MAG_QA + "mag_qa.txt",
            tax=MAG_QA + "mag_tax.txt"
        conda:
            "checkm"
        shell:
            "checkm qa -o 2 --tab_table -t {threads} -f {output.qa_txt} {input} {params.mag_qa} && "
            "checkm tree_qa -o 2 --tab_table -f {output.tax} {params.mag_qa}"

    # Too much crap logs, using 2>/dev/null
    rule checkm_coverage:
        input:
            bam=rules.sam_to_bam.output.final_bam,
            require=rules.metabat2_run.output, # required files
            require2=rules.checkm_lineage_wf.output # requlred file
        params:
            ftype="fa",
            mag=MAG
        threads: config["num_cpus"]
        output:
            MAG_QA + "mag_coverage.txt"
        conda:
            "checkm"
        shell:
            "checkm coverage -x {params.ftype} -t {threads} {params.mag} {output} {input.bam} 2>/dev/null"

    rule checkm_profile:
        input:
            rules.checkm_coverage.output
        output:
            MAG_QA + "mag_profiles.txt"
        conda:
            "checkm"
        shell:
            "checkm profile -q {input} --tab_table -f {output}"

    rule join_profiles_tax:
        input:
            tax=rules.checkm_qa.output.tax,
            qa_txt=rules.checkm_qa.output.qa_txt,
            profiles=rules.checkm_profile.output
        params:
            sedSTR=r"'s/[^\t]*_assembly: //g'"
        output:
            tmp1=temp(MAG_QA + "tmp1.txt"),
            tmp2=temp(MAG_QA + "tmp2.txt"),
            tmpsum=temp(MAG_QA + "mag_tmpsum.txt"),
            summary=MAG_QA + "mag_SUMMARY.txt"
        shell:
            "cut {input.tax} -f1,5 > {output.tmp1} && "
            "cut {input.qa_txt} -f1,6-11,13,15,17,19,23 > {output.tmp2} && "
            "paste {output.tmp1} {output.tmp2} > {output.tmpsum} && "
            "join {input.profiles} {output.tmpsum} -t $'\\t' | cut -f 1,3,4,6,7-19 | sed {params.sedSTR} > {output.summary}"

    rule checkm_plots:
        input:
            in1=rules.metabat2_run.output, # need for MAG
            in2=rules.checkm_lineage_wf.output # need for MAG_QA
        params:
            ftype="fa",
            mag=MAG,
            mag_qa=MAG_QA,
            out=QC_PLOTS
        output:
            # Something to signal this rule is completed
            QC_PLOTS + "_checkm_plots.done"
        conda:
            "checkm"
        shell:
            """
            checkm coding_plot --image_type pdf  -x {params.ftype} {params.mag_qa} {params.mag} {params.out} 95 || true
            checkm marker_plot --image_type pdf  -x {params.ftype} --dpi 400 {params.mag_qa} {params.mag} {params.out} || true
            checkm nx_plot --image_type pdf  -x {params.ftype} {params.mag} {params.out} || true
            touch {output}
            """

    rule taxbin_krona_txt:
        input:
            profiles=rules.checkm_profile.output,
            tax=rules.checkm_qa.output.tax
        output:
            TAXBIN + "bin/{sample}_4krona.txt"
        shell:
            "join {input.profiles} {input.tax} -t $'\\t' | cut -f6,10,11 | sed -e 's/..__/\\t/g' | sed -e 's/\\tunresolved//g' | sed -e '1 s/^/#/' > {output}"

    rule taxbin_krona_html:
        input:
            expand(rules.taxbin_krona_txt.output, sample=samples)
        output:
            TAXBIN + "TAXplots_MAGs.html"
        shell:
            "ktImportText {input} -o {output}"

    rule make_biom:
        input:
            profiles=expand(rules.checkm_profile.output, sample=samples),
            tax=expand(rules.checkm_qa.output.tax, sample=samples)
        params:
            map_file=config["map_file"],
            TAXCOL = "Taxonomy (contained)",
            PROFCOL = lambda wildcards: "{sample}_asmbFinal: mapped reads",
        output:
            BIOM_FILE_6C
        message: """rule {rule}
        Making biom file from '{params.TAXCOL}' column in output of checkm tree_qa,
        '{params.PROFCOL}' column in checkm profiles, and metadata.
        metadata: {params.map_file}
        input: {input}
        output: {output}
        jobid: {jobid}"""
        run:
            make_biom_file(str(rules.checkm_profile.output),
                       str(rules.checkm_qa.output.tax),
                       samples.keys(),
                       params.map_file,
                       str(output), params.TAXCOL, str(params.PROFCOL))

