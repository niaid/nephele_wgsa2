onstart:
    shell(
    """
    set +o pipefail
    echo "Dependencies:"
    fastp --version
    metaspades.py --version
    bowtie2 --version | awk '{{print "bowtie2 version", $3}}' | head -n1
    samtools --version | head -n1
    metabat2 2>&1 >/dev/null | grep version
    prodigal -v 2>&1 >/dev/null | head -n2 | tail -n1
    conda list checkm -n checkm | tail -n1 | awk '{{print $1,$2}}'
    ktImportText | head -n2 | tail -n1 | sed 's/[^a-zA-Z0-9. ]//g' | sed 's/^ *//g'
    metaprokka --version
    cat {config[minpath_script]} | grep version | head -n1
    verse -v | head -n2 | tail -n1
    kraken2 --version | head -n1
    conda list rgi -n rgi | tail -n1 | awk '{{print $1, $2}}'
    # rgi -h |grep "Resistance Gene Identifier - " | sed 's/ - / version /g'
    emapper.py --version | tail -n1 | awk '{{print $1}}'
    R --version | head -n1
    ribodetector_cpu --version | awk '{{print "ribodetector version", $2}}'
    Trinity --version | head -n1
    snakemake --version | awk '{{print "Snakemake version", $1}}'
    """)


rule all:
    input:
        pipeline_output,

# Step 2 starts
rule run_fastp:
    input:
        unpack(get_fastq_gz)
    threads: threads_per_job
    output:
        f=temp(TED_READS_FQS + "{sample}_R1_te.fastq.gz"),
        r=temp(TED_READS_FQS + "{sample}_R2_te.fastq.gz"),
        s_l_html=TED_READS + "{sample}_fastplog.html",
        s_l_json=temp(TED_READS + "{sample}_fastp.json"),
    params:
        s_l_text=TED_READS + "{sample}_fastplog.txt"
    run:
        shell(run_fastp_cmd())


rule run_kraken2_decontaminate:
    resources:
        mem_gb=config["total_mem_gb"]
    input:
        f=rules.run_fastp.output.f,
        r=rules.run_fastp.output.r
    threads: threads_per_job
    params:
        # Cannot put this in output because it will cause missing files. kraken2 requires to have the symbol # for output.
        out=TED_READS_FQS + "{sample}_R#_ted.fastq",
        decontaminate=config["decontaminate"],
        kr2confd_host=config["kr2confidence_host"],
    output:
        unclassified_out1=temp(TED_READS_FQS + "{sample}_R_1_ted.fastq"),
        unclassified_out2=temp(TED_READS_FQS + "{sample}_R_2_ted.fastq"),
        # out=temp(TED_READS + "{sample}_kr2outLOG.txt"), ## ommits saving and deleting large file
        report=TED_READS + "{sample}_kr2_contamREPORT.txt",
        outlog=TED_READS + "{sample}_kr2_contamLOG.txt"
    shell:
        "kraken2 --use-names --gzip-compressed --threads {threads} "
        "--confidence {params.kr2confd_host} --db {params.decontaminate} "
        "--paired {input.f} {input.r} "
        "--unclassified-out {params.out} "
        "--output -  --report {output.report} 2>> {output.outlog}"

rule zip_decontaminated:                                     
    input:
        f=rules.run_kraken2_decontaminate.output.unclassified_out1,
        r=rules.run_kraken2_decontaminate.output.unclassified_out2
    output:
        f=TED_READS_FQS + "{sample}_R1_ted.fastq.gz",
        r=TED_READS_FQS + "{sample}_R2_ted.fastq.gz"
    shell:
        "pigz -c {input.f} > {output.f} &&"
        "pigz -c {input.r} > {output.r}"


rule remove_rRNA:
    input:
        f=rules.run_kraken2_decontaminate.output.unclassified_out1,
        r=rules.run_kraken2_decontaminate.output.unclassified_out2,
    output:
        fread_gz=TED_READS_FQS + "{sample}_R1_ted_mtx.fastq.gz",
        rread_gz=TED_READS_FQS + "{sample}_R2_ted_mtx.fastq.gz",
    threads: threads_per_job
    params:
        ali_log = TED_READS  + "{sample}_rna_filter_LOG.txt",
    shell:"""
        ribodetector_cpu -t {threads} -l 100 --chunk_size 3200 -e norrna \
        -i {input.f} {input.r}  --log {params.ali_log} \
        -o {output.fread_gz} {output.rread_gz} 

        sed -e 's/\x1b\[[0-9;]*m//g' {params.ali_log}

        line_count=$(pigz -dc -p {threads} {output.fread_gz} | wc -l )
        if [ "$line_count" -lt 400 ]; then
            echo "ERROR: Fewer than 100 reads remain after rRNA filtering for {wildcards.sample}, and reads are unlikely to assemble. 
            If this dataset is 16S rRNA amplicon reads, consider using our DADA2 or QIIME pipelines."
            exit
        fi
        """


# Step 3 starts
rule run_kraken2_classification:
    resources:
        mem_gb=config["total_mem_gb"]
    input:
        f=lambda wildcards: rules.remove_rRNA.output.fread_gz if config["denovo_mtx"] else rules.zip_decontaminated.output.f,
        r=lambda wildcards: rules.remove_rRNA.output.rread_gz if config["denovo_mtx"] else rules.zip_decontaminated.output.r
    threads: threads_per_job
    params:
        classification_db=config["classification_db"],
        kr2confd_taxon=config["kr2confidence_taxonomic"],
    output:
        #out=temp(TED_READS_TAX_KLOGS + "{sample}_klog.txt"), ## omitting
        report=TED_READS_TAX + "reports/{sample}_taxREPORT.txt",
        outlog=TED_READS_TAX_KLOGS + "{sample}_classLOG.txt",
    shell:
        "kraken2 --use-names --gzip-compressed --threads {threads} "
        "--confidence {params.kr2confd_taxon} --db {params.classification_db} --memory-mapping "
        "--paired {input.f} {input.r}  --output - --report {output.report} 2>> {output.outlog}"

rule kreport2krona_per_sample:
    input:
        krfile=rules.run_kraken2_classification.output.report
    params:
        kreport2krona_script=config["kreport2krona_script"],
        sedRNK='s_\\tR[12]\\t(.*)(Viruses|Bacteria|Eukaryota|Archaea)_\\tD\\t\\1\\2_g',
        sedSTR=':a; 2s/\\t\\t/\\tUnclassified\\t/; ta', ## loops over empty TSV fields on line 2 (taxid0)
    output:
        tmpfile=temp(TED_READS_TAX_KLOGS + "reports/tmp_{sample}.txt"),
        binfile=TED_READS_TAX + "bin/{sample}_wTAXid_4krona.txt"
    shell:
        "sed -E '{params.sedRNK}' {input.krfile} > {output.tmpfile} &&"
        "python3 {params.kreport2krona_script} --report-file {output.tmpfile} --no-tax-prefixes -o {output.binfile} &&"
        "sed -i '{params.sedSTR}'  {output.binfile}"
 ##--> the first SED "fixes" the domain taxonomic rankings in the taxREPORT from the new R1/R2 root designation to the old D designation (consistent)
 ##--> kreport2krona_script is edited to disable table merging, since it overprints the bin/files (required output)
 ##--> removed the mod_kreport2krona_output rule cuz mods are above and no output 
 ##--> last SED old: 's/\\tUnclassified\\t\\t\\t\\t\\t\\t\\t0/\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\tUnclassified\\t0/g'
 ##--> last SED "fixes" the Unclassified row to contain string in all lineage columns <--## 


rule kreport2krona_import_text:
    input:
        expand(rules.kreport2krona_per_sample.output.binfile, sample=samples)
    output:
        TAXPLOTS
    shell:
        "ktImportText {input} -o {output}"

# Step 4 starts
if config["read_norm"]:
    rule norm_readDepth:
        input:
            Freads = lambda wildcards: rules.remove_rRNA.output.fread_gz if config["denovo_mtx"] else rules.zip_decontaminated.output.f,
            Rreads = lambda wildcards: rules.remove_rRNA.output.rread_gz if config["denovo_mtx"] else rules.zip_decontaminated.output.r,
        params:
            maxCov=config["readCoverage"],
            logfile=TED_READS + "{sample}_normLog.txt",
        output:
            normFread = temp(TED_READS_FQS + "{sample}_ted_norm_R1.fastq.gz"),
            normRread = temp(TED_READS_FQS + "{sample}_ted_norm_R2.fastq.gz"),
        threads: threads_per_job
        shell:
            """
            bbnorm.sh target={params.maxCov}  in={input.Freads} in2={input.Rreads} ecc=f prefilter=f \
                             out={output.normFread} out2={output.normRread}  threads={threads} &> {params.logfile}
            """


rule run_metaspades:
    input:
        in1=lambda wildcards: (rules.norm_readDepth.output.normFread if config["read_norm"] else rules.zip_decontaminated.output.f),
        in2=lambda wildcards: (rules.norm_readDepth.output.normRread if config["read_norm"] else rules.zip_decontaminated.output.r),
    params:
        out=ASMB_MGX_SAMPLE,
        tmp_dir=config["tmp_dir"],
        mem_gb=config["total_mem_gb"],
        scafout=temp(ASMB_MGX_SAMPLE + "scaffolds.fasta"),
        contout=temp(ASMB_MGX_SAMPLE + "contigs.fasta"),
        mspalog=temp(ASMB_MGX_SAMPLE + "spades.log"),
    threads: threads_per_job
    output:
        finout=ASMB_MGX_SAMPLE + "{sample}_scaffolds.fasta",
        cntigs=ASMB_MGX_SAMPLE + "{sample}_contigs.fasta",
        spalog=ASMB_MGX_SAMPLE + "{sample}_spadesLOG.txt",
    shell:"""
        metaspades.py -1 {input.in1} -2 {input.in2}  --memory {params.mem_gb} \
        --tmp-dir {params.tmp_dir} -o {params.out} -t {threads} --only-assembler 
        
        if [[ -f {params.mspalog} ]]; then  cp {params.mspalog} {output.spalog};  fi
        if [[ -f {params.scafout} ]]; then  cp {params.scafout} {output.finout};  fi
        if [[ -f {params.contout} ]]; then  cp {params.contout} {output.cntigs};  fi
    

        ## manual cleanup 
        rm -rf {params.out}K21/ {params.out}K33/ {params.out}K55/ {params.contout} {params.scafout} {params.mspalog} \
        {params.out}pipeline_state {params.out}tmp {params.out}misc {params.out}before_rr.fasta \
        {params.out}dataset.info {params.out}*params* {params.out}*.gfa {params.out}first_pe_contigs.fasta \
        {params.out}run_spades.sh {params.out}*.yaml {params.out}*.paths {params.out}assembly_graph.fastg 
        """
        # if grep -q "metaSPAdes unable to assemble reads into contigs" {params.spalog} ; then
        # echo "ERROR in sample {wildcards.sample}: metaSPAdes unable to assemble reads into contigs."
        # exit 1
        # fi

rule run_trinity:
    resources:
        mem_gb=lambda wildcards: int(config['total_mem_gb'] // 3)
    input:
        f=lambda wildcards: (rules.norm_readDepth.output.normFread if config["read_norm"] else rules.remove_rRNA.output.fread_gz),
        r=lambda wildcards: (rules.norm_readDepth.output.normRread if config["read_norm"] else rules.remove_rRNA.output.rread_gz),
    threads: threads_per_job
    params:
        out= ASMB_MTX_SAMPLE + "trinity_{sample}",
        fas= ASMB_MTX_SAMPLE + "trinity_{sample}.Trinity.fasta", ## as output temp() takes a while to remove
        log= ASMB_MTX_SAMPLE + "{sample}_trinityLOG.txt",
        mem= str(config['total_mem_gb'] // 3) + "G",
        threads =lambda wildcards: int(threads_per_job - 4),
        bfly_CPU=2,
        bfly_HeapSpace="20G",
    output:
        finout=ASMB_MTX_SAMPLE + "{sample}_contigs.fasta",
    shell:"""
        Trinity --seqType fq --left {input.f} --right {input.r} --CPU {params.threads} \
            --output {params.out} --full_cleanup --max_memory {params.mem} \
            --bflyHeapSpaceMax {params.bfly_HeapSpace} --bflyCPU {params.bfly_CPU} &> {params.log}
        mv {params.fas} {output.finout}
        rm {params.fas}.gene_trans_map
        
        line_count=$(wc -l < {output})
        if grep -q "No butterfly assemblies to report" {params.log} || [ "$line_count" -lt 2 ] ; then
            echo "ERROR in sample {wildcards.sample}: Trinity unable to assemble reads into transcripts."
            exit 1
        fi
        """

rule run_bbtools_stats:
    input:
        finfasta=lambda wildcards: (rules.run_trinity.output.finout if config["denovo_mtx"] else rules.run_metaspades.output.finout),
    params:
        asm=(ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE)
    output:
        out1=OUT_FILE + "_asmbFinal.fasta",
        out2=OUT_FILE + "_asmbStats.txt",
    shell:
        "sed $'s/_cov_/ cov_/g' {input.finfasta} > {output.out1} && "
        "stats.sh in={output.out1} out={output.out2} && "
        "printf \"\\nTEDreads mapping stats:\\n\"  >> {output.out2}"


# Step 5 starts
rule bowtie2_build:
    input:
        rules.run_bbtools_stats.output.out1
    params:
        basename=(ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}.db"
    threads: threads_per_job
    output:
        # to signal this step is completed
        temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "_bowtie2_build.done")
    shell:
       "bowtie2-build --quiet --threads {threads} {input} {params.basename} && touch {output}"

rule bowtie2_run:
    input:
        in1=lambda wildcards: rules.remove_rRNA.output.fread_gz if config["denovo_mtx"] else rules.zip_decontaminated.output.f,
        in2=lambda wildcards: rules.remove_rRNA.output.rread_gz if config["denovo_mtx"] else rules.zip_decontaminated.output.r,
        require=rules.bowtie2_build.output, # fake input so it can run after bowtie2_build for that sample
    params:
        index=(ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}.db",
        in4=ancient(rules.run_bbtools_stats.output.out2), # keep in params; its both input and output
    threads: threads_per_job
    output:
        sam=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}.sam")
    shell:
        "bowtie2 --phred33 --sensitive-local --no-unal --seed 4 "
        "-1 {input.in1} -2 {input.in2} "
        "-x {params.index} "
        "-S {output.sam} "
        "-p {threads} 2>> {params.in4}"

rule samtools_to_bam:
    input:
        rules.bowtie2_run.output.sam
    params:
        collate_tmp=config["tmp_dir"] + "{sample}_collate",
        srtfixd_tmp=config["tmp_dir"] + "{sample}_srtfixd",
        markdup_tmp=config["tmp_dir"] + "{sample}_markdup",
    threads: threads_per_job
    output:
        bam_initial=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}_initial.bam"),
        bam_colated=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}_colated.bam"),
        bam_fixmate=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}_fixmate.bam"),
        bam_fixsrtd=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}_fixsrtd.bam"),
        tmp_markdup=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}_markdup.txt"),
        final_bam=OUT_FILE + "_asmbFinal.bam",
        bam_index=OUT_FILE + "_asmbFinal.bam.bai",
    shell:
        "samtools sort {input} -o {output.bam_initial} -@ {threads} -T {params.srtfixd_tmp} && "
        "samtools collate {output.bam_initial} -o {output.bam_colated} -@ {threads} {params.collate_tmp} && "
        "samtools fixmate -m {output.bam_colated} {output.bam_fixmate} -@ {threads} && "
        "samtools sort {output.bam_fixmate} -o {output.bam_fixsrtd} -@ {threads} -T {params.srtfixd_tmp} && "
        "samtools markdup -r -s {output.bam_fixsrtd} -f {output.tmp_markdup} {output.final_bam} -@ {threads} -T {params.markdup_tmp} && "
        "samtools index -b {output.final_bam} -@ {threads}"


rule add_derep_stats:
    input:
        in1=rules.run_bbtools_stats.output.out2,
        in2=rules.samtools_to_bam.output.tmp_markdup
    params:
        stats_file=OUT_FILE + "_asmbStats.txt",
        tmp_out=(ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "{sample}_tmp_file.txt"
    output:
        # to signal this step is completed
        (ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "_added_derep_stats.done"
    shell:
        "cat {input.in1} <(printf \"\\nRead alignment de-replication stats:\\n\") {input.in2} > {params.tmp_out} && "
        "mv {params.tmp_out} {params.stats_file} && touch {output}"

rule scaffold_and_read_counts:
    input:
        final_bam=rules.samtools_to_bam.output.final_bam
    output:
        tmp_scafcov=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "tmp_scafcov.txt"),
        tmp_basecov=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "tmp_basecov.txt"),
        tmp_idx=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "tmp_idx.txt"),
        tmp_readcount=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "tmp_readcount.txt"),
        depths=OUT_FILE + "_asmbDepths.txt",
        tmp_scafcov1=temp((ASMB_MTX_SAMPLE if config["denovo_mtx"] else ASMB_MGX_SAMPLE) + "tmp_scafcov1.txt"),
        scafCoverage=OUT_FILE + "_asmbCovr.txt",
    shell:
        "pileup.sh {input.final_bam} out={output.tmp_scafcov} overwrite=true && "
        "sort -o {output.tmp_scafcov} {output.tmp_scafcov} && "
        "jgi_summarize_bam_contig_depths {input.final_bam} --outputDepth {output.depths} && "
        "sort {output.depths} | sed '1 s/^/#/' | cut -f 1-3 > {output.tmp_basecov} && "
        "samtools idxstats {input.final_bam} > {output.tmp_idx} && "
        "cut -f 1-3 {output.tmp_idx} | sed -e '1s/^/#contigName\\tLength\\tReadsCount\\n/' | sort | grep -v \"*\" > {output.tmp_readcount} && "
        "paste {output.tmp_readcount} {output.tmp_scafcov} {output.tmp_basecov} | cut -f 1,2,3,8-14,17 -d $'\\t' > {output.tmp_scafcov1} && "
        "awk 'BEGIN{{FS=OFS=\"\\t\"}} NR>1 {{if ($2>0 && $3>0) $12=sprintf(\"%0.2f\", $3*1e3/$2); else $12=0; print}}'  {output.tmp_scafcov1} | "
        "sed -e '1s/^/#NODE\\tlen\\tReads\\t\%NodeCovered\\t\%bpCovered\\tplusReads\\tminusReads\\t\%GC\\tMedFold\\tstDev\\tAveDepth\\tRPK\\n/' > {output.scafCoverage}"

# Step 6 starts
rule gene_prediction:
    input:
        finfas=rules.run_bbtools_stats.output.out1,
        require=expand(rules.scaffold_and_read_counts.output.scafCoverage, sample=samples),
    threads: threads_per_job
    output:
        gff=PREGENES_PREFIX + ".gff",
        faa=PREGENES_PREFIX + ".faa",
        fna=PREGENES_PREFIX + ".fna"
    shell:
        "prodigal -p meta -i {input.finfas} -f gff -o {output.gff} -a {output.faa} -d {output.fna} -q"

rule gff_to_gtf:
    input:
        rules.gene_prediction.output.gff
    params:
        gff2gtf_script=config["gff2gtf_script"]
    output:
        PREGENES_PREFIX + ".gtf"
    shell:
        "{params.gff2gtf_script} {input} > {output}"

rule run_verse:
    input:
        gtf=rules.gff_to_gtf.output,
        final_bam=rules.samtools_to_bam.output.final_bam
    threads: threads_per_job
    params:
        basename=GENES + "verse"
    output:
        out1=GENES + "verse.CDS.summary.txt",
        out2=temp(GENES + "verse.CDS.txt")
    shell:
        "verse -a {input.gtf} -t 'CDS' -g gene_id -z 0 -s 0 "
        "-o {params.basename} "
        "{input.final_bam} -T 4"

rule rename_verse_summary:
    input:
        rules.run_verse.output.out1
    output:
        PREGENES_PREFIX + "_stats.txt"
    shell:
        "mv {input} {output}"

rule tpm_normalization:
    input:
        gtf=rules.gff_to_gtf.output,
        verse_cds=rules.run_verse.output.out2
    output:
        tmp_lengths=temp(GENES + "tmp_lengths.txt"),
        tmp_counts=temp(GENES + "tmp_counts.txt"),
        tmp_coverage=temp(GENES + "tmp_coverage.txt"),
        tmp_rpk=temp(GENES + "tmp_RPK.txt"),
        ABUNtab=PREGENES_PREFIX + "_ABUNtab.txt"
    shell:
        "cut -f4,5,9 {input.gtf} | sed 's/gene_id //g' | gawk '{{print $3,$2-$1+1}}' | tr ' ' '\\t' | sed '1s/^/gene\\tlength\\n/' > {output.tmp_lengths} && "
        "join {output.tmp_lengths} {input.verse_cds} -t $'\\t' > {output.tmp_counts} && "
        "grep \"_\" {output.tmp_counts}   | awk -v OFS=\"\\t\" '{{$4 = sprintf(\"%0.0f\", $3*150/$2)}}1' | sort | sed -e '1s/^/#name\\tlen\\treads\\tcov\\n/' > {output.tmp_coverage} && "
        "grep \"_\" {output.tmp_coverage} | awk -v OFS=\"\\t\" '{{$5 = sprintf(\"%0.0f\", $3*1e3/$2)}}1' | sort | sed -e '1s/^/#name\\tlen\\treads\\tcov\\tRPK\\n/' > {output.tmp_rpk} && "
        "awk -v OFS=\"\\t\" 'NR==FNR{{sum+= $5; next}} FNR==1{{print $0,\"iTPM\"; next}} {{printf(\"%s %0.0f\\n\", $0,$5*1e6/sum)}}'  {output.tmp_rpk} {output.tmp_rpk} |sed -e 's/\\s/\\t/g' > {output.ABUNtab}  "

# Step 6A starts
if config["tax_genes"]:
    rule tax_classification_genes:
        resources:
            mem_gb=config["total_mem_gb"]
        input:
            fna=rules.gene_prediction.output.fna
        threads: threads_per_job
        params:
            classification_db=config["classification_db"],
            confidence_taxon=config["kr2confidence_taxonomic"],
        output:
            klog=temp(GENETAX_PREFIX + "_klog.txt"), ## needed for genes
