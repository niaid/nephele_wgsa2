# Dockerfile to create base image
FROM condaforge/mambaforge:23.3.1-1

RUN apt update && apt upgrade -y
RUN apt install -y unzip pigz

# Install dependencies
# Note: eggnog-mapper=2.1.6 Expected eggNOG DB version: 5.0.2 (http://eggnog5.embl.de/download/emapperdb-5.0.2/)
# The latest update of PuLP 2.8.0 removed deprecated API calls still used by snakemake
RUN mamba install -y -c conda-forge -c bioconda samtools=1.21 bbmap=39.15 fastp=0.24.0 spades=4.0.0 bowtie2=2.5.4 metabat2=2.17 prodigal=2.6.3 krona=2.8.1 metaprokka=1.15.0 verse=0.1.5 pulp=2.7.0 snakemake=7.32.4 kraken2=2.1.3 ncbi-amrfinderplus=3.12.8 eggnog-mapper=2.1.6 seqtk=1.4 sortmerna=4.3.6-0 trinity=2.15.1-3 salmon=1.10.2 r-base=4.4.0 r-ragg=1.3.3 sh=2.2.1 biom-format=2.1.16 awscli
RUN export CONDA_PREFIX=/opt/conda && amrfinder -u
# MinPath
RUN wget https://github.com/doandm/MinPath/archive/refs/heads/master.zip \
    && unzip master.zip \
    && rm master.zip \
    && mv MinPath-master /usr/local/src/MinPath

RUN mamba create -n checkm -y -c conda-forge -c bioconda python=3.8 checkm-genome=1.2.2

# Download and unzip sortmerna database
RUN wget https://github.com/biocore/sortmerna/releases/download/v4.3.4/database.tar.gz \
    && mkdir /mnt/rRNA_databases_v4 \
    && tar -xzvf database.tar.gz -C /mnt/rRNA_databases_v4\
    ## Speed of rRNA filtering increases significantly if the database is pre-indexed:
    && sortmerna --index 1 \
       --ref /mnt/rRNA_databases_v4/smr_v4.3_default_db.fasta \
       --idx-dir /mnt/rRNA_databases_v4

# Install R packages
ADD dependencies.R /tmp/dependencies.R
RUN --mount=type=secret,id=GITHUB_PAT GITHUB_PAT=$(cat /run/secrets/GITHUB_PAT) Rscript /tmp/dependencies.R
